{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "personal-site",
    "main": "./worker/index.ts",
    "compatibility_date": "2026-10-24",
    "routes": [
        { "pattern": "icenine.dev", "custom_domain": true },
        { "pattern": "www.icenine.dev", "custom_domain": true },
    ],
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "icenine-polls",
            "database_id": "530d7eb4-faf9-46da-a761-5fd48984cf57",
        },
    ],
    "ratelimits": [
        {
            "name": "CREATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 5, "period": 60 },
        },
        {
            "name": "BALLOT_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 10, "period": 60 },
        },
    ],
    "triggers": {
        // Daily at 09:17 UTC (4:17 AM Central). Cron times are always UTC
        "crons": ["17 9 * * *"],
    },
}
