{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "personal-site",
    "compatibility_date": "2026-10-24",
    "routes": [
        { "pattern": "icenine.dev", "custom_domain": true },
        { "pattern": "www.icenine.dev", "custom_domain": true },
    ],
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
    },
}
